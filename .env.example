# Copy to .env for local runs. NEVER commit real values (.env is gitignored).
# On Render, set these in the service's Environment tab instead.

# Required: IBM Quantum Platform API key
IBM_QUANTUM_TOKEN=

# Optional: IBM instance (CRN or name)
IBM_INSTANCE=open-instance

# Browser origins allowed to call the API (your Vercel URL)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: if set, clients must send header X-API-Key with this value
API_KEY=

RATE_LIMIT_PER_MIN=6
